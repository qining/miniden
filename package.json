{
  "name": "miniden",
  "private": true,
  "description": "MiniDen — 自家房子的迷你模型，看家具放不放得下（单文件构建：npm run build → dist/app.html（公开入口）+ dist/planner.html（个人入口））",
  "scripts": {
    "build": "node build.mjs",
    "size:check": "node scripts/size-budget.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures": "node scripts/make-fixtures.mjs",
    "schema:build": "node scripts/build-schema.mjs",
    "geo:build": "node scripts/build-geo.mjs",
    "storage:build": "node scripts/build-storage.mjs",
    "pdf:build": "node scripts/build-pdf-lib.mjs",
    "ui:gate": "node scripts/ui-gate.mjs",
    "ui:gate:update": "node scripts/ui-gate.mjs --update",
    "ui:gate:selftest": "node scripts/ui-gate.mjs --selftest",
    "slo": "node scripts/slo.mjs",
    "slo:headful": "node scripts/slo.mjs --headful",
    "slo:ci": "node scripts/slo.mjs --public --ci",
    "storage:probe": "node scripts/storage-probe.mjs",
    "test:coverage": "vitest run --coverage",
    "e2e": "node scripts/e2e.mjs",
    "e2e:ci": "node scripts/e2e.mjs --ci",
    "e2e:public": "node scripts/e2e.mjs --public",
    "e2e:all": "node scripts/e2e.mjs --entry=all"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.3",
    "dxf-parser": "^1.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pdfjs-dist": "^4.10.38",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
