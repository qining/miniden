{
  "name": "miniden",
  "private": true,
  "description": "MiniDen — 自家房子的迷你模型，看家具放不放得下（单文件构建：npm run build → dist/app.html（公开入口）+ dist/planner.html（个人入口））",
  "scripts": {
    "build": "node build.mjs",
    "size:check": "node scripts/size-budget.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixtures": "node scripts/make-fixtures.mjs",
    "schema:build": "node scripts/build-schema.mjs",
    "geo:build": "node scripts/build-geo.mjs",
    "pdf:build": "node scripts/build-pdf-lib.mjs",
    "ui:gate": "node scripts/ui-gate.mjs",
    "ui:gate:update": "node scripts/ui-gate.mjs --update",
    "ui:gate:selftest": "node scripts/ui-gate.mjs --selftest"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "dxf-parser": "^1.1.2",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^4.10.38",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
